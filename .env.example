# Copiez ce fichier en `.env.local` (non versionné) et adaptez les valeurs.

# URL du serveur PocketBase lu par le site (vide = site 100 % JSON, sans édition en ligne).
VITE_POCKETBASE_URL=http://127.0.0.1:8090

# Superuser PocketBase : créé au premier `npm run pb:serve`, utilisé par `npm run pb:seed`.
PB_ADMIN_EMAIL=admin@exemple.fr
PB_ADMIN_PASSWORD=change-moi-12-caracteres-min

# Premier compte éditeur (connexion sur /admin), créé par `npm run pb:seed`.
PB_EDITOR_EMAIL=editeur@exemple.fr
PB_EDITOR_PASSWORD=change-moi-aussi-123
