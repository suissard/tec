{
  "name": "toulouse-esport-connect",
  "version": "2.0.0",
  "description": "Site officiel de Toulouse Esport Connect (TEC) — Application Vue 3",
  "scripts": {
    "dev": "vite",
    "build": "vite build",
    "preview": "vite preview",
    "lint": "eslint . --fix",
    "lint:fix": "eslint . --fix",
    "lint:check": "eslint .",
    "typecheck": "vue-tsc -p tsconfig.app.json --noEmit && tsc -p tsconfig.node.json --noEmit",
    "test:unit": "vitest run",
    "test:coverage": "vitest run --coverage",
    "legacy:build": "node ./scripts/build.js && npm run legacy:build:css",
    "legacy:build:css": "tailwindcss -i ./css/input.css -o ./css/tailwind.min.css --minify",
    "legacy:watch:css": "tailwindcss -i ./css/input.css -o ./css/tailwind.min.css --watch",
    "legacy:serve": "python3 -m http.server 8080",
    "legacy:lint": "eslint -c eslint.legacy.config.mjs js/"
  },
  "keywords": [
    "esport",
    "toulouse",
    "association",
    "gaming",
    "occitanie",
    "vue3",
    "vite"
  ],
  "author": "Toulouse Esport Connect",
  "license": "MIT",
  "dependencies": {
    "@vueuse/core": "^10.11.0",
    "pinia": "^2.1.7",
    "vue": "^3.4.38",
    "vue-router": "^4.4.3",
    "zod": "^4.6.7"
  },
  "devDependencies": {
    "@eslint/js": "^10.0.1",
    "@playwright/test": "^1.64.1",
    "@tailwindcss/cli": "^4.3.3",
    "@tailwindcss/postcss": "^4.3.3",
    "@types/node": "^22.20.5",
    "@vitejs/plugin-vue": "^6.0.10",
    "@vitest/coverage-v8": "^5.0.5",
    "@vue/eslint-config-prettier": "^10.2.0",
    "@vue/eslint-config-typescript": "^14.9.0",
    "@vue/test-utils": "^2.5.1",
    "@vue/tsconfig": "^0.5.1",
    "eslint": "^10.13.0",
    "eslint-config-prettier": "^10.1.8",
    "eslint-plugin-prettier": "^5.5.7",
    "eslint-plugin-vue": "^10.11.1",
    "globals": "^16.5.0",
    "jsdom": "^25.0.1",
    "postcss": "^8.4.41",
    "prettier": "^3.3.3",
    "tailwindcss": "^4.3.3",
    "typescript": "~5.6.2",
    "vite": "^8.3.5",
    "vite-plugin-sitemap": "^0.8.2",
    "vitest": "^5.0.5",
    "vue-tsc": "^2.1.4"
  }
}
